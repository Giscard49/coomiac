{
  "name": "coomiac",
  "private": true,
  "version": "1.0.0",
  "description": "COOMIAC PROJET — responsibly sourced coltan, cassiterite, copper, cobalt and gold from Walikale, DR Congo.",
  "author": "COOMIAC PROJET",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt",
    "photos:optimize": "node scripts/optimize-photos.mjs",
    "typecheck": "tsc --noEmit",
    "seed:admin": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/seed-admin.mjs",
    "deploy:rules": "npx --yes firebase-tools deploy --only firestore:rules,storage",
    "emulators": "npx --yes firebase-tools emulators:start"
  },
  "dependencies": {
    "firebase": "^13.1.0",
    "jose": "^6.2.14",
    "nodemailer": "^7.0.13",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "firebase-admin": "^14.5.0",
    "oxfmt": "^0.2.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.3.5"
  }
}
