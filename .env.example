# ---------------------------------------------------------------------------
# Firebase web app config (safe to expose in the browser — these identify the
# project, they do not grant admin access). Restart `npm run dev` after editing.
# Firebase console → Project settings → Your apps → Web app.
# ---------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
# Bucket name from Firebase Console → Storage. New projects usually use
# <project>.firebasestorage.app; older projects use <project>.appspot.com.
# The uploader automatically retries the other name if the first is missing.
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# Server-only secrets. Never prefix these with VITE_, otherwise Vite would
# inline them into the browser bundle.
# ---------------------------------------------------------------------------
# OpenAI key used by /api/translate.
OPENAI_API_KEY=
# Optional: defaults to gpt-4o-mini.
OPENAI_TRANSLATION_MODEL=gpt-4o-mini
# Used by /api/translate to verify Firebase ID tokens.
FIREBASE_PROJECT_ID=

# ---------------------------------------------------------------------------
# First-admin seed script (npm run seed:admin). Not used by the website.
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Either paste the service-account JSON as one line, its base64 encoding, or
# leave this empty and set GOOGLE_APPLICATION_CREDENTIALS to the JSON file path.
FIREBASE_SERVICE_ACCOUNT=
